{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash",
  "theme": "system",
  "autoupdate": true,

  "mode": {
    "plan": {
      "model": "opencode-go/qwen3.7-max",
      "tools": {
        "read": true,
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    "build": {
      "model": "opencode-go/deepseek-v4-flash",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true
      }
    }
  },

  "permission": {
    "*": "ask",
    "read": "allow",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "npm test": "allow",
      "npm run lint": "allow",
      "git status*": "allow"
    }
  },

  "watcher": {
    "ignore": [
      "node_modules/**",
      "venv/**",
      ".venv/**",
      "dist/**",
      "build/**",
      ".env",
      ".env.local",
      "*.db"
    ]
  }
}

